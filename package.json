{
  "name": "ryan-gpt",
  "description": "Chat with a bot trained on every episode of Ryan Carniato's epic stream episodes.",
  "author": "Anthony Campolo",
  "keywords": [
    "Ryan Carniato",
    "ChatGPT"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "as": "bun cli/commander.ts",
    "compact:transcripts": "bun --no-env-file cli/compact-transcripts.ts",
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "repo": "bash repomix.sh"
  },
  "dependencies": {
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "@solidjs/start": "1.2.1",
    "commander": "14.0.3",
    "github-slugger": "2.0.0",
    "solid-js": "1.9.11",
    "vinxi": "0.5.11"
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "repomix": "1.11.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
